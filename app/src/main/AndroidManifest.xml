<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Safety check: find dangerous / remote-control apps; uninstall button; scam warning pop-ups -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Only used when you tap "Import from bank SMS" in History -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- only to show "online / offline" on the Check payment screen -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+: needed so the app can find and bind the phone's text-to-speech engine -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Auto-detect every installed UPI app: they all open upi://pay links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <package android:name="com.google.android.apps.nbu.paisa.merchant" />
        <package android:name="com.phonepe.merchant" />
        <package android:name="com.phonepe.app.business" />
        <package android:name="com.paytm.business" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.sbi.SBIFreedomPlus" />
        <package android:name="com.sbi.upi" />
        <package android:name="com.Version1" />
        <!-- Remote-control apps used in screen-sharing scams (Scan & Pay warns if installed) -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.anydesk.adcontrol.ad1" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.sand.airmirror" />
        <package android:name="com.rsupport.mobizen.sec" />
        <package android:name="com.splashtop.streamer.addon.knox" />
        <package android:name="com.remotepc.android" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads UPI apps' on-screen history (only while started from History, max 10 min) -->
        <service
            android:name=".HistoryReaderService"
            android:exported="true"
            android:label="UPI Voice – read app history"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/history_reader" />
        </service>

        <!-- Third app icon "Scan & Pay": scam-checked UPI payments -->
        <activity
            android:name=".PayActivity"
            android:exported="true"
            android:icon="@mipmap/ic_pay"
            android:label="Scan &amp; Pay"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.shivarghya.upivoice.pay"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SafetyActivity"
            android:exported="false"
            android:label="Safety check" />

        <activity
            android:name=".PaymentCheckActivity"
            android:exported="false"
            android:label="Check payment"
            android:windowSoftInputMode="stateVisible" />

        <activity
            android:name=".BankSmsActivity"
            android:exported="false"
            android:label="Bank messages" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Transaction history" />

        <!-- Second app icon "UPI QR": the customer-facing QR screen. Same app & process as the
             voice, so "₹X received" appears on screen at the same instant it is spoken. -->
        <activity
            android:name=".QrActivity"
            android:exported="true"
            android:icon="@mipmap/ic_qr"
            android:label="UPI QR"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.shivarghya.upivoice.qr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads payment notifications from UPI / bank apps. Bound by the system, so no
             foreground service or persistent notification is needed. -->
        <service
            android:name=".PaymentListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bank credit SMS. Works even if the app process was killed. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
